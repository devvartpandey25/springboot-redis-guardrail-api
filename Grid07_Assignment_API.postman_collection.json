      "name": "Phase 1 - Create Post",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"authorId\": 1,\n  \"content\": \"My first post\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/posts",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "posts"
          ]
        },
        "description": "Creates a new post.\n\nResponse:\n{\n  \"id\": 1,\n  \"authorId\": 1,\n  \"content\": \"My first post\",\n  \"createdAt\": \"2026-04-24T14:45:00\"\n}"
      }
    },
